# Copy to .env.local for local development. On Vercel: Project → Settings → Environment Variables.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only and never reach the browser.

# --- Site ---------------------------------------------------------------
# Canonical origin (no trailing slash). Used for canonicals, hreflang, sitemap, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://socialmediakomplett.de
# Indexing is enabled automatically on Vercel production (VERCEL_ENV=production).
# On other hosts set to "true". Set to "false" to force noindex + Disallow everywhere.
# NEXT_PUBLIC_ALLOW_INDEXING=true

# Public contact details shown on the site (leave empty until confirmed).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# --- Contact form (Resend, https://resend.com) ---------------------------
# API key with "Sending access" only.
RESEND_API_KEY=
# Mailbox that receives enquiries.
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Social Media Komplett <anfrage@mail.socialmediakomplett.de>"
CONTACT_FROM_EMAIL=
